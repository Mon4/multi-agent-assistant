# =====================================================================
# multi-agent-assistant — environment variables TEMPLATE
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real credentials to the repo.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Gemini API key  (REQUIRED)
# ---------------------------------------------------------------------
# Used by:
#   - google ADK agents (gemini-2.5-pro / gemini-2.5-flash)
#   - tools/rag/rag.py  ->  os.getenv("GOOGLE_API_KEY")
# How to create: https://aistudio.google.com/apikey  -> "Create API key"
GOOGLE_API_KEY=your_google_api_key_here

# ---------------------------------------------------------------------
# 2. Google Cloud project settings  (REQUIRED for Vertex AI / ADK)
# ---------------------------------------------------------------------
# How to create: https://console.cloud.google.com/
#   -> create/select a project, note its ID
#   -> enable the Vertex AI API (or use Gemini API key only, see #1)
#   -> pick a region close to you (e.g. us-central1, europe-west1)
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1

# ---------------------------------------------------------------------
# 3. Langfuse observability / tracing  (OPTIONAL)
# ---------------------------------------------------------------------
# Used by tools/rag/rag.py (@observe() decorator) to trace RAG runs.
# If left empty, tracing is disabled and the app still works.
# How to create: https://cloud.langfuse.com  -> sign in -> New organization
#                -> New project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
